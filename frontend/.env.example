NEXT_PUBLIC_API_URL="http://localhost:3001/api"

# Modo demo: cuando es "true", el frontend no llama al backend real — toda
# la API se simula en el navegador con datos de muestra (ver
# src/lib/mock/). Úsalo para desplegar solo el frontend (ej. Vercel) antes
# de tener el backend + bases de datos en producción. Ponlo en "false" (o
# quítalo) en cuanto el backend esté desplegado y NEXT_PUBLIC_API_URL
# apunte a él.
NEXT_PUBLIC_DEMO_MODE="false"

# Servidor
PORT=3001
NODE_ENV=development

# PostgreSQL — Fase 1 usa Supabase (free tier). Ver supabase/README.md.
# Para desarrollo 100% local con Docker Compose, usar en su lugar:
# DATABASE_URL="postgresql://sutl:sutl_dev_password@postgres:5432/sutl_db?schema=public"
# DIRECT_URL="postgresql://sutl:sutl_dev_password@postgres:5432/sutl_db?schema=public"
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# MongoDB Atlas (eventos de tracking — free tier M0)
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sutl_tracking?retryWrites=true&w=majority"

# Redis (colas de trabajo con BullMQ). En Docker Compose local: redis://localhost:6380
# Sin esta variable las colas quedan deshabilitadas y la API sigue funcionando.
REDIS_URL="redis://localhost:6380"

# Correo (SMTP). En desarrollo: Mailpit de Docker Compose (ver en http://localhost:8025).
# En producción: el SMTP de SES / SendGrid / Mailgun / Google Workspace.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM="SUTL <notificaciones@sutl.local>"

# WhatsApp Cloud API (Meta). Sin estas dos variables el canal WhatsApp queda deshabilitado.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=
# WHATSAPP_API_VERSION=v21.0

# Cifrado en reposo (AES-256-GCM) de secretos como el de los webhooks. Obligatoria en producción.
# Genera una con: openssl rand -base64 32   (y guárdala en un gestor de secretos; si se pierde,
# los secretos cifrados no se pueden recuperar).
ENCRYPTION_KEY=

# Solo desarrollo: permite webhooks a http y a direcciones locales. Se ignora en producción.
# WEBHOOKS_ALLOW_PRIVATE=true

# JWT
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Correo que recibe los contactos del formulario de la landing (diagnóstico). Sin él, los contactos
# igual se guardan en la base pero no llega aviso.
# CONTACT_INBOX_EMAIL=ventas@tu-dominio.com

# Límites de peticiones por minuto y por IP (opcionales). Por defecto: login 5, global 120.
# Solo suben fuera de producción (para suites e2e de navegador); en producción solo endurecen.
# LOGIN_RATE_LIMIT=5
# RATE_LIMIT=120

# CORS
FRONTEND_URL="http://localhost:3000"

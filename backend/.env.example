# Servidor
PORT=3001
NODE_ENV=development

# PostgreSQL (Prisma)
DATABASE_URL="postgresql://sutl:sutl_dev_password@postgres:5432/sutl_db?schema=public"

# MongoDB Atlas (eventos de tracking)
MONGO_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/sutl_tracking?retryWrites=true&w=majority"

# JWT
JWT_ACCESS_SECRET="change_me_access_secret"
JWT_REFRESH_SECRET="change_me_refresh_secret"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# CORS
FRONTEND_URL="http://localhost:3000"

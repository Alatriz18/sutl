// Esquema SUTL — adaptado al Plan de Acción v2.0 (importaciones/exportaciones,
// navieras, documentos, notificaciones, alertas, reportes, planes SaaS,
// auditoría). DB destino inicial: Supabase (Postgres gestionado). Al migrar a
// AWS RDS Aurora solo cambia DATABASE_URL — el schema es 100% Postgres
// estándar, sin extensiones propietarias de Supabase.
//
// Alcance de esta revisión: se amplía el modelo de datos para soportar todo
// el dominio del plan. Los módulos backend (documentos, notificaciones,
// alertas, reportes, suscripciones, auditoría) todavía NO tienen API propia —
// las tablas existen como base para implementarlos en las siguientes fases.
// Las integraciones externas (navieras, Stripe, Twilio, FCM/APNs) quedan
// modeladas como credenciales/config por tenant, sin lógica de integración
// real todavía (ver CarrierCredential).
//
// Nota sobre super_admin: no pertenece a un tenant "cliente" real, pero el
// modelo User exige tenantId (fila compartida). Se usa un tenant especial
// "SVK Solutions" (ver prisma/seed.ts) como owner de las cuentas super_admin
// del panel SaaS.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Requerido por el connection pooler de Supabase (pgbouncer) en modo
  // transaction: las migraciones necesitan una conexión directa sin pooling.
  directUrl = env("DIRECT_URL")
}

enum RolUsuario {
  super_admin
  admin_tenant
  operador
  cliente_final
}

enum EstadoEnvio {
  creado
  en_transito
  en_aduana
  entregado
  incidencia
}

enum TipoEnvio {
  importacion
  exportacion
}

enum ModoTransporte {
  maritimo
  aereo
  terrestre
}

enum TipoCarrier {
  naviera
  aerolinea
  terrestre
}

enum TipoDocumento {
  bl
  awb
  factura
  pedimento
  packing_list
  otro
}

enum CanalNotificacion {
  email
  push
  sms
}

enum EstadoNotificacion {
  pendiente
  enviado
  fallido
}

enum TipoAlerta {
  retraso
  cambio_estado
  llegada_proxima
  documento_faltante
  personalizada
}

enum EstadoSuscripcion {
  prueba
  activa
  vencida
  cancelada
}

// ---------------------------------------------------------------------------
// ERP logístico (v3) — cotizaciones, reservas, tarifas, facturación,
// consolidación de carga, almacén y flota. Inspirado en el flujo estándar de
// un freight forwarder (ej. Cargo 77): Quote → Booking → Shipment → Invoice.
// ---------------------------------------------------------------------------

enum TipoPartner {
  cliente
  agente
  proveedor
  transportista
}

enum EstadoCotizacion {
  borrador
  enviada
  aprobada
  rechazada
  convertida
}

enum EstadoReserva {
  pendiente
  confirmada
  cancelada
  convertida
}

enum EstadoContenedor {
  abierto
  cerrado
  en_transito
  entregado
}

enum TipoFactura {
  cxc
  cxp
}

enum EstadoFactura {
  pendiente
  pagada
  vencida
  anulada
}

enum TipoMovimientoInventario {
  entrada
  salida
  transferencia
}

enum EstadoVehiculo {
  disponible
  en_ruta
  mantenimiento
  inactivo
}

model Tenant {
  id        String   @id @default(uuid())
  nombre    String
  ruc       String?  @unique
  plan      String   @default("trial")
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  usuarios          User[]
  envios            Shipment[]
  suscripcion       Subscription?
  documentos        Document[]
  notificaciones    Notification[]
  alertas           Alert[]
  reportes          Report[]
  auditLogs         AuditLog[]
  carrierCredentials CarrierCredential[]

  partners       Partner[]
  quotes         Quote[]
  bookings       Booking[]
  rates          Rate[]
  contracts      Contract[]
  invoices       Invoice[]
  payments       Payment[]
  containers     Container[]
  warehouses     Warehouse[]
  inventoryItems InventoryItem[]
  stockMovements StockMovement[]
  vehicles       Vehicle[]
  drivers        Driver[]
  vehicleAssignments VehicleAssignment[]
  maintenanceRecords MaintenanceRecord[]

  @@map("tenants")
}

model User {
  id               String     @id @default(uuid())
  tenantId         String
  email            String
  password         String
  nombre           String
  rol              RolUsuario @default(operador)
  activo           Boolean    @default(true)
  refreshTokenHash String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id])

  documentosSubidos Document[]     @relation("DocumentoSubidoPor")
  reportesGenerados Report[]       @relation("ReporteGeneradoPor")
  notificaciones    Notification[] @relation("NotificacionDestinatario")
  auditLogs         AuditLog[]     @relation("AuditLogActor")
  cotizacionesCreadas Quote[]        @relation("QuoteCreadoPor")
  movimientosStock    StockMovement[] @relation("StockMovementResponsable")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
}

// Naviera / aerolínea / transportista terrestre — catálogo global compartido
// por todos los tenants (no es dato de negocio de un tenant específico).
model Carrier {
  id        String      @id @default(uuid())
  nombre    String
  tipo      TipoCarrier
  codigo    String?     @unique // SCAC (naviera) o código IATA (aerolínea)
  activo    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  envios      Shipment[]
  credenciales CarrierCredential[]
  quotes      Quote[]
  bookings    Booking[]
  rates       Rate[]
  contracts   Contract[]
  containers  Container[]

  @@map("carriers")
}

// Credenciales/config de integración de un tenant con una naviera/aerolínea
// puntual (API key sandbox, etc.). Sin lógica de integración real todavía —
// es la base para "Módulo de configuración de integraciones externas" (Fase 3).
model CarrierCredential {
  id        String   @id @default(uuid())
  tenantId  String
  carrierId String
  apiKey    String?
  apiSecret String?
  activo    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@unique([tenantId, carrierId])
  @@map("carrier_credentials")
}

model Shipment {
  id                 String         @id @default(uuid())
  tenantId           String
  codigoGuia         String         @unique
  tipo               TipoEnvio      @default(exportacion)
  modo               ModoTransporte @default(maritimo)
  carrierId          String?
  bookingId          String?        @unique
  containerId        String?
  referenciaDocumento String?       // número de BL o AWB
  remitenteNombre    String
  destinatarioNombre String
  destinatarioEmail  String?
  origen             String
  destino            String
  puertoOrigen       String?
  puertoDestino      String?
  pesoKg             Float?
  fechaEstimadaSalida   DateTime?
  fechaEstimadaLlegada  DateTime?
  estado             EstadoEnvio    @default(creado)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  carrier   Carrier?   @relation(fields: [carrierId], references: [id])
  booking   Booking?   @relation(fields: [bookingId], references: [id])
  container Container? @relation(fields: [containerId], references: [id])

  documentos          Document[]
  alertas             Alert[]
  invoices            Invoice[]
  inventoryItems      InventoryItem[]
  vehicleAssignments  VehicleAssignment[]

  @@index([tenantId])
  @@index([carrierId])
  @@index([containerId])
  @@map("shipments")
}

// Documentos del envío (BL, AWB, facturas, pedimentos). El archivo en sí vive
// en S3 (o equivalente) — aquí solo se guarda la referencia (urlArchivo) y el
// versionado. Sin lógica de upload real todavía.
model Document {
  id            String        @id @default(uuid())
  tenantId      String
  shipmentId    String
  tipo          TipoDocumento
  nombreArchivo String
  urlArchivo    String
  version       Int           @default(1)
  subidoPorId   String?
  createdAt     DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  shipment Shipment @relation(fields: [shipmentId], references: [id])
  subidoPor User?   @relation("DocumentoSubidoPor", fields: [subidoPorId], references: [id])

  @@index([tenantId])
  @@index([shipmentId])
  @@map("documents")
}

// Notificaciones salientes (email/push/sms) a un usuario del tenant. Sin
// integración real con SES/FCM/Twilio todavía — el `estado` queda en
// `pendiente` hasta que se conecte el proveedor correspondiente.
model Notification {
  id            String             @id @default(uuid())
  tenantId      String
  userId        String?
  canal         CanalNotificacion
  tipo          String
  asunto        String
  mensaje       String
  estado        EstadoNotificacion @default(pendiente)
  enviadoAt     DateTime?
  createdAt     DateTime           @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation("NotificacionDestinatario", fields: [userId], references: [id])

  @@index([tenantId])
  @@map("notifications")
}

// Umbral/regla de alerta configurable por tenant, opcionalmente asociada a un
// envío puntual (ej. "avisarme si este envío lleva 3 días en aduana").
model Alert {
  id         String     @id @default(uuid())
  tenantId   String
  shipmentId String?
  tipo       TipoAlerta
  condicion  Json?
  activo     Boolean    @default(true)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([tenantId])
  @@map("alerts")
}

// Reporte generado (analytics/KPIs, export PDF/Excel/CSV). El archivo final
// vive en S3 — aquí se guarda la referencia y metadata del reporte.
model Report {
  id            String   @id @default(uuid())
  tenantId      String
  tipo          String
  formato       String   // pdf | excel | csv
  urlArchivo    String?
  generadoPorId String?
  createdAt     DateTime @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  generadoPor User?  @relation("ReporteGeneradoPor", fields: [generadoPorId], references: [id])

  @@index([tenantId])
  @@map("reports")
}

// Catálogo global de planes de suscripción del panel SaaS (Fase 5).
model SubscriptionPlan {
  id             String   @id @default(uuid())
  nombre         String   @unique
  precioMensual  Float
  maxUsuarios    Int?
  maxEnvios      Int?
  features       Json?
  activo         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  suscripciones Subscription[]

  @@map("subscription_plans")
}

// Suscripción activa de un tenant a un plan. Campos de Stripe quedan nulos
// hasta que se conecte el proveedor de pagos real.
model Subscription {
  id                   String            @id @default(uuid())
  tenantId             String            @unique
  planId               String
  estado               EstadoSuscripcion @default(prueba)
  fechaInicio          DateTime          @default(now())
  fechaFin             DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  tenant Tenant           @relation(fields: [tenantId], references: [id])
  plan   SubscriptionPlan @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

// Bitácora de auditoría: quién hizo qué sobre qué entidad. `entidad` +
// `entidadId` apuntan a cualquier tabla de negocio (shipments, users, etc.)
// sin FK física para no acoplar el log a un esquema en particular.
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String?
  accion     String
  entidad    String
  entidadId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User?  @relation("AuditLogActor", fields: [userId], references: [id])

  @@index([tenantId])
  @@index([entidad, entidadId])
  @@map("audit_logs")
}

// CRM — directorio de clientes, agentes, proveedores y transportistas de un
// tenant. Punto de partida para reemplazar los campos de texto libre
// (remitenteNombre/destinatarioNombre) en flujos nuevos como Quote/Booking.
model Partner {
  id             String      @id @default(uuid())
  tenantId       String
  tipo           TipoPartner
  nombre         String
  taxId          String?
  email          String?
  telefono       String?
  direccion      String?
  contactoNombre String?
  activo         Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  quotes    Quote[]
  bookings  Booking[]
  invoices  Invoice[]

  @@index([tenantId])
  @@map("partners")
}

// Cotización de flete solicitada por un cliente. Al aprobarse se convierte en
// un Booking (reserva), que a su vez se convierte en un Shipment real.
model Quote {
  id              String           @id @default(uuid())
  tenantId        String
  numero          String           @unique
  clienteId       String
  tipo            TipoEnvio
  modo            ModoTransporte
  carrierId       String?
  origen          String
  destino         String
  pesoKg          Float?
  volumenM3       Float?
  tarifaEstimada  Float?
  moneda          String           @default("USD")
  estado          EstadoCotizacion @default(borrador)
  validoHasta     DateTime?
  notas           String?
  creadoPorId     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  cliente  Partner  @relation(fields: [clienteId], references: [id])
  carrier  Carrier? @relation(fields: [carrierId], references: [id])
  creadoPor User?   @relation("QuoteCreadoPor", fields: [creadoPorId], references: [id])

  bookings Booking[]

  @@index([tenantId])
  @@map("quotes")
}

// Reserva confirmada — precursora de un Shipment. Cuando se despacha de
// verdad, se crea el Shipment y se enlaza vía `shipment` (relación 1:1).
model Booking {
  id                   String        @id @default(uuid())
  tenantId             String
  quoteId              String?
  clienteId            String
  tipo                 TipoEnvio
  modo                 ModoTransporte
  carrierId            String?
  origen               String
  destino              String
  fechaEstimadaCarga   DateTime?
  estado               EstadoReserva @default(pendiente)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  quote   Quote?   @relation(fields: [quoteId], references: [id])
  cliente Partner  @relation(fields: [clienteId], references: [id])
  carrier Carrier? @relation(fields: [carrierId], references: [id])
  shipment Shipment?

  @@index([tenantId])
  @@map("bookings")
}

// Tarifa de referencia por naviera/ruta/modo — usada para estimar el costo de
// una cotización. `tenantId` nulo = tarifa pública de mercado; con tenantId =
// tarifa negociada exclusiva de ese tenant.
model Rate {
  id            String         @id @default(uuid())
  tenantId      String?
  carrierId     String
  origen        String
  destino       String
  modo          ModoTransporte
  tipo          TipoEnvio
  unidad        String         // ej. 'contenedor_20', 'contenedor_40', 'kg', 'awb'
  precioBase    Float
  moneda        String         @default("USD")
  vigenteDesde  DateTime       @default(now())
  vigenteHasta  DateTime?
  activo        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  tenant  Tenant?  @relation(fields: [tenantId], references: [id])
  carrier Carrier  @relation(fields: [carrierId], references: [id])

  @@index([tenantId])
  @@index([carrierId])
  @@map("rates")
}

// Contrato marco con una naviera/proveedor (condiciones comerciales,
// vigencia). `condiciones` queda libre en JSON para no atarse a un esquema
// rígido de cláusulas.
model Contract {
  id              String    @id @default(uuid())
  tenantId        String
  carrierId       String
  nombre          String
  numeroContrato  String?
  vigenteDesde    DateTime
  vigenteHasta    DateTime?
  condiciones     Json?
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  carrier Carrier @relation(fields: [carrierId], references: [id])

  @@index([tenantId])
  @@map("contracts")
}

// Factura — unifica cuentas por cobrar (a un cliente) y cuentas por pagar (a
// un proveedor/naviera) según `tipo`. `partnerId` es el cliente o el
// proveedor según corresponda.
model Invoice {
  id                String        @id @default(uuid())
  tenantId          String
  tipo              TipoFactura
  numero            String        @unique
  partnerId         String
  shipmentId        String?
  montoTotal        Float
  moneda            String        @default("USD")
  estado            EstadoFactura @default(pendiente)
  fechaEmision      DateTime      @default(now())
  fechaVencimiento  DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  partner  Partner   @relation(fields: [partnerId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  pagos Payment[]

  @@index([tenantId])
  @@map("invoices")
}

model Payment {
  id         String   @id @default(uuid())
  tenantId   String
  invoiceId  String
  monto      Float
  metodo     String?
  referencia String?
  fecha      DateTime @default(now())
  createdAt  DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([tenantId])
  @@map("payments")
}

// Contenedor de consolidación — agrupa varios Shipment (ver Shipment.containerId).
model Container {
  id                String           @id @default(uuid())
  tenantId          String
  numeroContenedor  String           @unique
  tipo              String?          // ej. '20GP', '40HC'
  carrierId         String?
  origen            String
  destino            String
  estado            EstadoContenedor @default(abierto)
  capacidadM3       Float?
  fechaCierre       DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  carrier Carrier? @relation(fields: [carrierId], references: [id])
  envios  Shipment[]

  @@index([tenantId])
  @@map("containers")
}

model Warehouse {
  id        String   @id @default(uuid())
  tenantId  String
  nombre    String
  direccion String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id])
  ubicaciones WarehouseLocation[]
  items       InventoryItem[]

  @@index([tenantId])
  @@map("warehouses")
}

model WarehouseLocation {
  id          String   @id @default(uuid())
  warehouseId String
  codigo      String   // ej. 'A-01-03'
  tipo        String?
  capacidad   Float?
  createdAt   DateTime @default(now())

  warehouse Warehouse       @relation(fields: [warehouseId], references: [id])
  items     InventoryItem[]

  @@unique([warehouseId, codigo])
  @@map("warehouse_locations")
}

model InventoryItem {
  id           String   @id @default(uuid())
  tenantId     String
  warehouseId  String
  shipmentId   String?
  ubicacionId  String?
  sku          String?
  descripcion  String
  cantidad     Int
  unidad       String   @default("unidad")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id])
  shipment  Shipment?          @relation(fields: [shipmentId], references: [id])
  ubicacion WarehouseLocation? @relation(fields: [ubicacionId], references: [id])

  movimientos StockMovement[]

  @@index([tenantId])
  @@map("inventory_items")
}

model StockMovement {
  id              String                   @id @default(uuid())
  tenantId        String
  inventoryItemId String
  tipo            TipoMovimientoInventario
  cantidad        Int
  responsableId   String?
  notas           String?
  fecha           DateTime                 @default(now())
  createdAt       DateTime                 @default(now())

  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  responsable   User?         @relation("StockMovementResponsable", fields: [responsableId], references: [id])

  @@index([tenantId])
  @@map("stock_movements")
}

model Vehicle {
  id           String         @id @default(uuid())
  tenantId     String
  placa        String         @unique
  tipo         String         // camion, van, etc.
  capacidadKg  Float?
  estado       EstadoVehiculo @default(disponible)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  tenant      Tenant               @relation(fields: [tenantId], references: [id])
  asignaciones VehicleAssignment[]
  mantenimientos MaintenanceRecord[]

  @@index([tenantId])
  @@map("vehicles")
}

model Driver {
  id        String   @id @default(uuid())
  tenantId  String
  nombre    String
  licencia  String
  telefono  String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant              @relation(fields: [tenantId], references: [id])
  asignaciones VehicleAssignment[]

  @@index([tenantId])
  @@map("drivers")
}

model VehicleAssignment {
  id               String    @id @default(uuid())
  tenantId         String
  vehicleId        String
  driverId         String
  shipmentId       String?
  fechaAsignacion  DateTime  @default(now())
  fechaFin         DateTime?
  createdAt        DateTime  @default(now())

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  vehicle  Vehicle   @relation(fields: [vehicleId], references: [id])
  driver   Driver    @relation(fields: [driverId], references: [id])
  shipment Shipment? @relation(fields: [shipmentId], references: [id])

  @@index([tenantId])
  @@map("vehicle_assignments")
}

model MaintenanceRecord {
  id          String   @id @default(uuid())
  tenantId    String
  vehicleId   String
  tipo        String
  descripcion String?
  costo       Float?
  fecha       DateTime @default(now())
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@map("maintenance_records")
}
